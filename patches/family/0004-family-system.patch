+ if(action.type!=='startFamily')return null;const family=state(home,true),data=action.systemData?.family,ids=data?.parentIds??action.participants.map(i=>idOf(model,i)),days=data?.arrivalDays??FAMILY_RULES.defaultArrivalDays;
