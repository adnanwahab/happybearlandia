+import {describe,expect,test} from 'bun:test';
+import {advanceFamilySystem,completeFamilyAction,inspectHouseFamilySystem,planFamilyAction,validateHouseFamilySystem} from './family-system.js';
+
+function model(){
+ const m={prefix:'test',minute:10000,config:{seed:1,maxLogEntries:1000},people:{age:new Uint8Array([1,1]),ageYears:new Uint8Array([30,30]),household:new Uint16Array([0,0]),employed:new Uint8Array(2),work:new Uint16Array(2),x:new Float32Array(2),z:new Float32Array(2),remaining:new Float32Array(2)},social:{ties:{}},events:[],eventCounts:{},weight:1};
+ m.social.ties['["test-p0","test-p1"]']={a:'test-p0',b:'test-p1',kind:'Acquaintances',friendship:80,romance:80,tension:0,familiarity:90,dating:true,commitment:{status:'married',datingSinceMinute:1,engagedSinceMinute:2,marriedSinceMinute:3,endedMinute:null},directed:{'test-p0':{trust:90,attraction:80,resentment:0},'test-p1':{trust:90,attraction:80,resentment:0}},memories:[]};return m;
+}
+describe('house family lifecycle',()=>{
+ test('start family requires marriage and consent',()=>{const m=model(),home={householdId:'test-h0',systems:{}};expect(planFamilyAction(m,home,{type:'startFamily',systemOptions:{consentingPersonIds:['test-p0','test-p1'],arrivalDays:1}},[0,1]).available).toBe(true);});
+ test('completed plan creates a household dependent only when due',()=>{const m=model(),home={householdId:'test-h0',systems:{}},action={id:'family-1',type:'startFamily',participants:[0,1],systemData:{family:{parentIds:['test-p0','test-p1'],arrivalDays:1}}};const result=completeFamilyAction(m,home,action,1000);expect(result.status).toBe('expecting');expect(Object.keys(inspectHouseFamilySystem(m,home).children)).toHaveLength(0);m.minute=2440;advanceFamilySystem(m,home,1000,2440);const snapshot=inspectHouseFamilySystem(m,home);expect(Object.keys(snapshot.children)).toHaveLength(1);expect(Object.values(snapshot.children)[0].parentIds).toEqual(['test-p0','test-p1']);expect(validateHouseFamilySystem(m,home)).toBe(true);});
+});
