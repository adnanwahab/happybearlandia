+export const FAMILY_VERSION='house-family.v1';
+export const FAMILY_RULES=Object.freeze({defaultArrivalDays:3,maxArrivalDays:280,maxPlans:16,maxChildren:16,maxEvents:64,source:'Compressed household game-time family lifecycle; newborns are household dependents until dynamic population capacity exists.'});
