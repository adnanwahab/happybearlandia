+ if(relationshipCommitment(model,ids[0],ids[1]).status!=='married')return{available:false,reason:'Start a family requires a married relationship'};
+ const family=state(home,false);if(activePlanFor(family,ids))return{available:false,reason:'This couple already has an active family plan'};
+ if((family?.plans.length??0)>=FAMILY_RULES.maxPlans||Object.keys(family?.children??{}).length>=FAMILY_RULES.maxChildren)return{available:false,reason:'This household reached the bounded family-record limit'};
