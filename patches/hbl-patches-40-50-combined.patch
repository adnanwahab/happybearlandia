@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createSimulationAdapter, simulateExperiment } from "./simulation-adapter.js";
+import { attributeParameterEffects } from "./parameter-attribution.js";
+
+const experiment = {
+  id: "exp_attr",
+  plan: { id: "plan_attr", actions: [] },
+  worldModel: { variables: [
+    { id: "x", baseline: 0.8, range: { min: 0, max: 1 } },
+    { id: "unused", baseline: 0.7, range: { min: 0, max: 1 } },
+  ] },
+  outcomes: { metricRegistry: [] },
+};
+const worldBatch = {
+  seed: 9,
+  worlds: [
+    { id: "w1", conditions: { x: 0.8, unused: 0.7 }, normalized: { x: 0.8, unused: 0.7 }, deviations: { x: 0, unused: 0 } },
+    { id: "w2", conditions: { x: 0.9, unused: 0.8 }, normalized: { x: 0.9, unused: 0.8 }, deviations: { x: 0.1, unused: 0.1 } },
+  ],
+};
+const patch = { id: "p1", edits: [
+  { parameterId: "x", label: "X", from: 0.5, to: 0.8 },
+  { parameterId: "unused", label: "Unused", from: 0.4, to: 0.7 },
+], additions: [] };
+
+test("leave-one-out attribution finds modeled contribution and zero for unused variables", async () => {
+  const adapter = createSimulationAdapter({
+    id: "attr-test",
+    simulateWorld({ world }) { return { score: world.conditions.x * 100, metrics: {}, status: "mixed" }; },
+  });
+  const planBatch = await simulateExperiment(experiment, worldBatch, adapter);
+  const result = await attributeParameterEffects({ experiment, worldBatch, adapter, patch, planBatch });
+  const x = result.parameters.find((row) => row.parameterId === "x");
+  const unused = result.parameters.find((row) => row.parameterId === "unused");
+  assert.equal(x.meanScoreContribution, 30);
+  assert.equal(unused.meanScoreContribution, 0);
+  assert.equal(result.annotatedPlanBatch.simulations[0].parameterContributions[0].parameterId, "x");
+});
diff --git a/world/parameter-constraints.js b/world/parameter-constraints.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-constraints.js
@@ -0,0 +1,100 @@
+import { buildSimulationConfig } from "./simulation-config.js";
+
+function asArray(value) { return Array.isArray(value) ? value : []; }
+function finite(value) { const number = Number(value); return Number.isFinite(number) ? number : null; }
+
+function compare(actual, op, expected) {
+  if (actual === null || expected === null) return false;
+  if (op === ">") return actual > expected;
+  if (op === ">=") return actual >= expected;
+  if (op === "<") return actual < expected;
+  if (op === "<=") return actual <= expected;
+  if (op === "!=") return actual !== expected;
+  return actual === expected;
+}
+
+function normalizeCondition(raw) {
+  if (!raw || typeof raw !== "object") return null;
+  const parameterId = raw.parameterId ?? raw.parameter_id ?? raw.parameter ?? raw.id;
+  const value = finite(raw.value ?? raw.target ?? raw.threshold);
+  if (typeof parameterId !== "string" || !parameterId.trim() || value === null) return null;
+  return { parameterId: parameterId.trim(), op: String(raw.op || raw.operator || ">=").trim(), value };
+}
+
+export function collectParameterConstraints(experiment) {
+  const rows = [...asArray(experiment?.plan?.parameterConstraints), ...asArray(experiment?.plan?.parameter_constraints)];
+  for (const action of asArray(experiment?.plan?.actions)) {
+    rows.push(...asArray(action?.parameterConstraints), ...asArray(action?.parameter_constraints));
+  }
+  return rows.map((raw, index) => {
+    const when = normalizeCondition(raw?.if ?? raw?.when);
+    const requires = asArray(raw?.requires).map(normalizeCondition).filter(Boolean);
+    return {
+      id: raw?.id || "constraint_" + (index + 1),
+      when,
+      requires,
+      policy: ["warn", "clamp", "reject"].includes(raw?.policy) ? raw.policy : "warn",
+      message: raw?.message || null,
+    };
+  }).filter((row) => row.requires.length);
+}
+
+function valueFor(config, parameterId) { return finite(config?.parameters?.[parameterId]?.baseline); }
+function conditionMet(config, condition) {
+  if (!condition) return true;
+  return compare(valueFor(config, condition.parameterId), condition.op, condition.value);
+}
+function suggestedValue(requirement) { return requirement.value; }
+
+export function evaluateParameterConstraints(experiment, simulationConfig) {
+  const constraints = collectParameterConstraints(experiment);
+  const violations = [];
+  for (const constraint of constraints) {
+    if (!conditionMet(simulationConfig, constraint.when)) continue;
+    const failed = constraint.requires.filter((requirement) => !conditionMet(simulationConfig, requirement));
+    if (!failed.length) continue;
+    violations.push({
+      constraintId: constraint.id,
+      policy: constraint.policy,
+      message: constraint.message || ("Constraint " + constraint.id + " is not satisfied."),
+      when: constraint.when,
+      failedRequirements: failed.map((requirement) => ({
+        ...requirement,
+        actual: valueFor(simulationConfig, requirement.parameterId),
+        suggestedValue: suggestedValue(requirement),
+      })),
+    });
+  }
+  return {
+    schemaVersion: "parameter-constraint-evaluation.v1",
+    constraintCount: constraints.length,
+    violationCount: violations.length,
+    hasReject: violations.some((row) => row.policy === "reject"),
+    hasClampSuggestion: violations.some((row) => row.policy === "clamp"),
+    violations,
+    valid: !violations.some((row) => row.policy === "reject"),
+  };
+}
+
+export function validateParameterConfiguration(experiment, overrides = {}, options = {}) {
+  const simulationConfig = options.simulationConfig || buildSimulationConfig(experiment, overrides, { parameterPatch: options.parameterPatch });
+  return { simulationConfig, evaluation: evaluateParameterConstraints(experiment, simulationConfig) };
+}
+
+export function suggestedConstraintOverrides(evaluation, existingOverrides = {}) {
+  const overrides = typeof structuredClone === "function" ? structuredClone(existingOverrides || {}) : JSON.parse(JSON.stringify(existingOverrides || {}));
+  for (const violation of evaluation?.violations || []) {
+    if (violation.policy !== "clamp") continue;
+    for (const requirement of violation.failedRequirements || []) {
+      const current = overrides[requirement.parameterId] || {};
+      overrides[requirement.parameterId] = {
+        ...current,
+        baseline: requirement.suggestedValue,
+        reason: "Constraint suggestion from " + violation.constraintId + "; review before applying.",
+      };
+    }
+  }
+  return overrides;
+}
+
+export const __test = { compare, normalizeCondition, conditionMet, valueFor };
