+  outcomes: { metricRegistry: [] },
+  lineage: { revision: 1, appliedParameterPatch: { id: "p1", sourceFingerprint: "s1", edits: [{ parameterId: "x", from: 0.5, to: 0.8 }], additions: [] } },
+};
+const patch = experiment.lineage.appliedParameterPatch;
+const worldBatch = {
+  seed: 42,
+  simulationConfig: { parameters: { x: { baseline: 0.8 } } },
