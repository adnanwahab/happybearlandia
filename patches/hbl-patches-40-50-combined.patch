diff --git a/world/simulation-config.js b/world/simulation-config.js
new file mode 100644
--- /dev/null
+++ b/world/simulation-config.js
@@ -0,0 +1,86 @@
+const isObject = (value) => Boolean(value) && typeof value === "object" && !Array.isArray(value);
+
+function finite(value, fallback = null) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : fallback;
+}
+
+function clone(value) {
+  return value == null ? value : (typeof structuredClone === "function" ? structuredClone(value) : JSON.parse(JSON.stringify(value)));
+}
+
+function stableStringify(value) {
+  if (Array.isArray(value)) return `[${value.map(stableStringify).join(",")}]`;
+  if (isObject(value)) return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${stableStringify(value[key])}`).join(",")}}`;
+  return JSON.stringify(value);
+}
+
+function hashString(value) {
+  let hash = 0x811c9dc5;
+  const text = String(value);
+  for (let index = 0; index < text.length; index += 1) {
+    hash ^= text.charCodeAt(index);
+    hash = Math.imul(hash, 0x01000193);
+  }
+  return (hash >>> 0).toString(16).padStart(8, "0");
+}
+
+export function classifyParameterConnection(variable) {
+  if (!variable) return "unknown";
+  if (variable.modelBinding || variable.connected === true) return "mechanic-connected";
+  if (variable.causalBinding || variable.causalNodeId || variable.causal_node_id) return "causal-graph-connected";
+  if (variable.source === "plan-parameter-patch" && variable.connected !== true) return "sampled-only";
+  return "mechanic-connected";
+}
+
+export function buildSimulationConfig(experiment, overrides = {}, options = {}) {
+  const variables = Array.isArray(experiment?.worldModel?.variables) ? experiment.worldModel.variables : [];
+  const parameters = {};
+  for (const variable of variables) {
+    const override = isObject(overrides?.[variable.id]) ? overrides[variable.id] : {};
+    const rawMin = finite(override.min ?? override.range?.min, finite(variable.range?.min, 0));
+    const rawMax = finite(override.max ?? override.range?.max, finite(variable.range?.max, 1));
+    const min = Math.min(rawMin, rawMax);
+    const max = Math.max(rawMin, rawMax);
+    const baselineCandidate = finite(override.baseline, finite(variable.baseline, (min + max) / 2));
+    const baseline = Math.max(min, Math.min(max, baselineCandidate));
+    parameters[variable.id] = {
+      id: variable.id,
+      label: variable.label || variable.id,
+      category: variable.category || "custom",
+      unit: variable.unit || "index",
+      baseline,
+      min,
+      max,
+      locked: typeof override.locked === "boolean" ? override.locked : Boolean(variable.locked),
+      connection: classifyParameterConnection(variable),
+      source: override.reason ? "override" : (variable.source || "model"),
+      reason: override.reason || variable.reason || null,
+    };
+  }
+
+  const appliedPatch = options.parameterPatch
+    || experiment?.lineage?.appliedParameterPatch
+    || null;
+  const core = {
+    schemaVersion: "hbl-simulation-config.v1",
+    experimentId: experiment?.id || null,
+    planId: experiment?.plan?.id || null,
+    parameterPatchId: appliedPatch?.id || null,
+    parameterPatchSourceFingerprint: appliedPatch?.sourceFingerprint || null,
+    model: clone(experiment?.model || null),
+    parameters,
+  };
+
+  return {
+    ...core,
+    id: `simcfg_${hashString(stableStringify(core))}`,
+  };
+}
+
+export function attachSimulationConfig(target, config) {
+  if (!target || typeof target !== "object") return target;
+  return { ...target, simulationConfig: clone(config) };
+}
+
+export const __test = { stableStringify, hashString };
