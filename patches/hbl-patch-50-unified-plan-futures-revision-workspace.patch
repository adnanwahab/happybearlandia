+  const revisedExperiment = applyParameterRevision(experiment, suggestion);
+  const revisionPatch = revisionSuggestionPatch(revisedExperiment, worldBatch, suggestion);
+  const nextOverrides = clone(overrides || {});
+  const variable = variableFor(revisedExperiment, revisionPatch.edits[0].parameterId);
+  const current = nextOverrides[revisionPatch.edits[0].parameterId] || {};
+  nextOverrides[revisionPatch.edits[0].parameterId] = {
+    ...current,
+    baseline: revisionPatch.edits[0].to,
+    min: current.min ?? variable?.range?.min,
+    max: current.max ?? variable?.range?.max,
+    locked: typeof current.locked === "boolean" ? current.locked : Boolean(variable?.locked),
