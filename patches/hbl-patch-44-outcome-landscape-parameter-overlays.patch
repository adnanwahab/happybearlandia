diff --git a/world/outcome-landscape-parameter.test.js b/world/outcome-landscape-parameter.test.js
new file mode 100644
--- /dev/null
+++ b/world/outcome-landscape-parameter.test.js
@@ -0,0 +1,22 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { projectOutcomeLandscape } from "./outcome-landscape.js";
+
+const simulations = [
+  { worldId: "a", score: 40, status: "negative", world: { conditions: { x: 2 }, normalized: { x: 0.2 } }, parameterContributions: [{ scoreContribution: -3 }] },
+  { worldId: "b", score: 70, status: "positive", world: { conditions: { x: 8 }, normalized: { x: 0.8 } }, parameterContributions: [{ scoreContribution: 5 }] },
+];
+
+test("landscape projection preserves world identity while exposing parameter overlay values", () => {
+  const base = projectOutcomeLandscape(simulations);
+  const overlay = projectOutcomeLandscape(simulations, { mode: "parameter", parameterId: "x" });
+  assert.deepEqual(base.points.map((row) => row.id), overlay.points.map((row) => row.id));
+  assert.equal(overlay.points[0].overlayValue, 0.2);
+  assert.equal(overlay.points[1].overlayValue, 0.8);
+});
+
+test("plan benefit overlay sums per-world parameter contributions", () => {
+  const projection = projectOutcomeLandscape(simulations, { mode: "plan-benefit" });
+  assert.equal(projection.points[0].overlayValue, -3);
+  assert.equal(projection.points[1].overlayValue, 5);
+});
