# Local runtime config for HappyBearLandia server (Bun auto-loads .env)

# Server port
PORT=3000

# World map data: set this to an Overpass interpreter that is reachable from your network
# Example: OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_URL=

# Overpass request timeout in milliseconds
OVERPASS_TIMEOUT_MS=15000

# Civic package API base URL
DEAR_CONGRESS_URL=https://dear-congress.fly.dev/api

# Optional player patch voting (private SQLite volume, secret from server environment)
# HBL_PATCH_VOTE_SECRET=generate-a-long-random-secret
# HBL_PATCH_VOTE_DB_PATH=/private/persistent/patch-votes.sqlite
