# Local runtime config for HappyBearLandia server (Bun auto-loads .env)

# Server port
PORT=3000

# World map data: set this to an Overpass interpreter that is reachable from your network
# Example: OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_URL=

# Overpass request timeout in milliseconds
OVERPASS_TIMEOUT_MS=15000

# Civic package API base URL
DEAR_CONGRESS_URL=https://dear-congress.fly.dev/api

# Redacted server logs served at /api/server-logs (see ops/server-logs/README.md)
# HBL_SERVER_LOG_DIR=.hbl-private/server-logs
# HBL_SERVER_LOG_RETENTION_DAYS=14
# HBL_SERVER_LOGS=off

# Optional player patch voting (private SQLite volume, secret from server environment)
# HBL_PATCH_VOTE_SECRET=generate-a-long-random-secret
# HBL_PATCH_VOTE_DB_PATH=/private/persistent/patch-votes.sqlite

# GitHub webhook on public game server only; sign secret must be >= 32 characters.
# HBL_GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# On the SEPARATE trusted agent host only (NEVER in a browser/client bundle).
# HBL_GITHUB_APP_ID=123456
# HBL_GITHUB_INSTALLATION_ID=12345678
# HBL_GITHUB_APP_PRIVATE_KEY=load-actual-PEM-from-secure-file-or-secret-manager
# Enable the worker explicitly with --github-app-prs after provisioning.
# Guarded repo auto-merge is separately controlled by repository Actions variable
# HBL_GUARDED_AUTOMERGE_ENABLED and still requires reviews/CI.
