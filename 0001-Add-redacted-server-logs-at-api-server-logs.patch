diff --git a/ops/server-logs/README.md b/ops/server-logs/README.md
new file mode 100644
index 0000000..9a4fe97
--- /dev/null
+++ b/ops/server-logs/README.md
@@ -0,0 +1,54 @@
+# Server logs
+
+`GET /api/server-logs` is a public, read-only view of the server's recent logs, so people
+and agents (such as the daily improvement run) can see what fails or runs slowly in
+production without access to Fly.
+
+## What is recorded
+
+- Page views, API calls and WebSocket upgrades: method, normalized path, status and duration.
+- Every failed (4xx/5xx) or slow (1.5 s or more) request, including static assets.
+- Exceptions thrown by route handlers: name, message and the top six stack frames.
+- `console.error` and `console.warn` output. Output still prints to stdout and stderr as before.
+- A `server started` entry with the build ID each time the process starts, which covers deploys and cold starts.
+
+Not recorded: successful static-asset requests, successful health checks, requests to
+`/api/server-logs`, and Fly's own platform logs.
+
+## Privacy
+
+Everything is redacted before it is written, so the files and the endpoint hold the same data.
+
+- Never stored: IP addresses, query strings, fragments, headers, cookies, user agents or request bodies.
+- Paths keep their route shape, but record IDs, share codes, room codes, house and date names become `:id`.
+- Messages and stack frames lose emails, bearer tokens, `key=value` secrets, URL query strings,
+  IPv4 and IPv6 addresses, coordinates, UUIDs, long hex or mixed tokens and long numbers.
+  Messages are capped at 500 characters.
+
+The endpoint is public on purpose. If a log line ever carries personal data, fix the
+redaction or the code that logged it. Set `HBL_SERVER_LOGS=off` to stop recording and
+return 404 from the endpoint.
+
+## Query parameters
+
+| Parameter | Default | Meaning |
+| --- | --- | --- |
+| `since` | `24h` | A duration (`30m`, `6h`, `2d`) or an ISO timestamp, within the retention window |
+| `until` | now | ISO timestamp |
+| `level` | `info` | Minimum level: `info`, `warn` or `error` |
+| `type` | all | `request`, `exception`, `console`, `lifecycle` or `notice` |
+| `path` | all | Path prefix, for example `/api/area` |
+| `limit` | `200` | Entries returned, 0 to 1000. The summary always covers the whole matching window. |
+
+For example, `/api/server-logs?since=24h&level=warn` returns the last day's problems. The
+response has a `summary` (status classes, busiest paths, top 404s, 5xx routes, slowest
+routes by p95, repeated errors, process starts and builds) and `entries`, newest first.
+Responses are cached for 10 seconds.
+
+## Storage
+
+JSON lines, one file per UTC day (`server-YYYY-MM-DD.jsonl`), in `HBL_SERVER_LOG_DIR`. In
+production this is `/data/server-logs` on the Fly volume, so history survives machine stops
+and deploys. Locally it defaults to `.hbl-private/server-logs`. The directory must be
+outside the public static roots. Files older than `HBL_SERVER_LOG_RETENTION_DAYS` (default
+14) are deleted, and each day stops at 20 MB with a single `notice` entry.
diff --git a/ops/server-logs/api.js b/ops/server-logs/api.js
new file mode 100644
index 0000000..105e345
--- /dev/null
+++ b/ops/server-logs/api.js
@@ -0,0 +1,200 @@
+import { captureConsole, createServerLogRecorder, instrumentFetch } from './capture.js';
+import { normalizePath } from './redact.js';
+import { createServerLogStore, DEFAULT_LOG_DIR } from './store.js';
+
+export const SCHEMA = 'server-logs.v1';
+const DAY_MS = 86400000;
+const LEVELS = { info: 0, warn: 1, error: 2 };
+const TYPES = new Set(['request', 'exception', 'console', 'lifecycle', 'notice']);
+const UNITS = { m: 60000, h: 3600000, d: DAY_MS };
+const OFF = /^(0|off|false|no|disabled)$/i;
+const PRIVACY = 'Redacted before storage: no IP addresses, query strings, headers, cookies or request bodies are kept, '
+  + 'and IDs, share codes, emails, tokens and coordinates are removed from paths and messages.';
+const NOT_RECORDED = ['successful static-asset requests', 'successful health checks', 'requests to /api/server-logs',
+  'Fly platform logs (proxy, machine start and stop)'];
+
+const json = (body, status = 200, headers = {}) => Response.json(body, {
+  status, headers: { 'cache-control': 'no-store', 'x-robots-tag': 'noindex', ...headers },
+});
+
+function parseSince(value, now, retentionDays) {
+  const floor = now - retentionDays * DAY_MS;
+  if (value === null || value === '') return Math.max(floor, now - DAY_MS);
+  const relative = /^(\d{1,4})([mhd])$/.exec(value);
+  if (relative) return Math.max(floor, now - Number(relative[1]) * UNITS[relative[2]]);
+  const at = Date.parse(value);
+  if (!Number.isFinite(at)) throw new Error('since must be a duration such as 30m, 6h or 2d, or an ISO timestamp.');
+  return Math.min(now, Math.max(floor, at));
+}
+
+export function parseQuery(params, now, retentionDays) {
+  const since = parseSince(params.get('since'), now, retentionDays);
+  let until = now;
+  if (params.get('until')) {
+    const at = Date.parse(params.get('until'));
+    if (!Number.isFinite(at)) throw new Error('until must be an ISO timestamp.');
+    until = Math.min(now, at);
+  }
+  if (until < since) throw new Error('until must be later than since.');
+  const level = params.get('level') || 'info';
+  if (!Object.hasOwn(LEVELS, level)) throw new Error('level must be info, warn or error.');
+  const type = params.get('type') || null;
+  if (type && !TYPES.has(type)) throw new Error('type must be request, exception, console, lifecycle or notice.');
+  const limitText = params.get('limit');
+  const limit = limitText === null ? 200 : Number(limitText);
+  if (!/^\d{1,4}$/.test(limitText ?? '200') || limit > 1000) throw new Error('limit must be a whole number from 0 to 1000.');
+  const path = params.get('path') ? normalizePath(params.get('path')) : null;
+  return { since, until, level, type, limit, path };
+}
+
+function bump(map, key, base, at) {
+  const item = map.get(key) || { ...base, count: 0, firstAt: at, lastAt: at };
+  item.count++;
+  if (at < item.firstAt) item.firstAt = at;
+  if (at > item.lastAt) item.lastAt = at;
+  map.set(key, item);
+}
+const top = (items, score, count) => [...items].sort((a, b) => score(b) - score(a)).slice(0, count);
+function percentile(values, fraction) {
+  if (!values.length) return null;
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.min(sorted.length - 1, Math.max(0, Math.ceil(fraction * sorted.length) - 1))];
+}
+
+// Aggregates the whole matching window, not only the entries returned, so a reader
+// sees which routes fail or crawl and which errors repeat at a glance.
+export function summarizeEntries(entries) {
+  const byLevel = { info: 0, warn: 0, error: 0 };
+  const byType = {};
+  const byStatusClass = {};
+  const byKind = {};
+  const routes = new Map();
+  const missing = new Map();
+  const failures = new Map();
+  const problems = new Map();
+  const builds = new Set();
+  let requests = 0;
+  let serverStarts = 0;
+  for (const entry of entries) {
+    if (Object.hasOwn(byLevel, entry.level)) byLevel[entry.level]++;
+    byType[entry.type] = (byType[entry.type] || 0) + 1;
+    if (entry.type === 'request') {
+      requests++;
+      const statusClass = `${Math.floor(entry.status / 100)}xx`;
+      byStatusClass[statusClass] = (byStatusClass[statusClass] || 0) + 1;
+      byKind[entry.kind] = (byKind[entry.kind] || 0) + 1;
+      const key = `${entry.method} ${entry.path}`;
+      const route = routes.get(key) || { method: entry.method, path: entry.path, kind: entry.kind, count: 0, errors: 0, ms: [] };
+      route.count++;
+      if (entry.status >= 400) route.errors++;
+      if (Number.isFinite(entry.ms) && route.ms.length < 5000) route.ms.push(entry.ms);
+      routes.set(key, route);
+      if (entry.status === 404) bump(missing, entry.path, { path: entry.path }, entry.t);
+      if (entry.status >= 500) bump(failures, `${key} ${entry.status}`, { method: entry.method, path: entry.path, status: entry.status }, entry.t);
+    } else if (entry.type === 'lifecycle') {
+      if (entry.message === 'server started') serverStarts++;
+      if (entry.build) builds.add(entry.build);
+    } else {
+      const message = entry.type === 'exception' ? `${entry.name}: ${entry.message}` : entry.message;
+      bump(problems, `${entry.type}|${entry.level}|${entry.path || ''}|${message}`,
+        { type: entry.type, level: entry.level, message, ...(entry.path ? { path: entry.path } : {}) }, entry.t);
+    }
+  }
+  const routeList = [...routes.values()].map(({ ms, ...route }) => ({
+    ...route, p95Ms: percentile(ms, 0.95), maxMs: ms.length ? ms.reduce((a, b) => Math.max(a, b)) : null,
+  }));
+  return {
+    entries: entries.length, byLevel, byType,
+    requests: {
+      total: requests, byStatusClass, byKind,
+      topPaths: top(routeList, route => route.count, 15),
+      notFound: top(missing.values(), item => item.count, 15),
+      serverErrors: top(failures.values(), item => item.count, 15),
+      slowest: top(routeList.filter(route => route.p95Ms !== null), route => route.p95Ms, 10)
+        .map(({ method, path, count, p95Ms, maxMs }) => ({ method, path, count, p95Ms, maxMs })),
+    },
+    problems: top(problems.values(), item => item.count, 20),
+    serverStarts, builds: [...builds],
+  };
+}
+
+export function createServerLogsHandler(options = {}) {
+  const { store } = options;
+  const now = options.now || Date.now;
+  const cacheMs = options.cacheMs ?? 10000;
+  const cache = new Map();
+  return function handleServerLogs(request) {
+    if (request.method !== 'GET') return json({ error: 'Use GET /api/server-logs.' }, 405, { allow: 'GET' });
+    const url = new URL(request.url);
+    const at = now();
+    const key = [...url.searchParams].sort(([a], [b]) => a.localeCompare(b)).map(pair => pair.join('=')).join('&');
+    const cached = cache.get(key);
+    if (cached && at - cached.at < cacheMs) return json(cached.body);
+    let query;
+    try {
+      query = parseQuery(url.searchParams, at, store.retentionDays);
+    } catch (error) {
+      return json({ error: error.message }, 400);
+    }
+    const { entries, truncated } = store.read({ since: query.since, until: query.until });
+    const minimum = LEVELS[query.level];
+    const matching = entries.filter(entry => (LEVELS[entry.level] ?? 0) >= minimum
+      && (!query.type || entry.type === query.type)
+      && (!query.path || String(entry.path || '').startsWith(query.path)));
+    const body = {
+      schemaVersion: SCHEMA,
+      generatedAt: new Date(at).toISOString(),
+      build: options.buildId || 'unknown',
+      processStartedAt: options.startedAt || null,
+      window: { since: new Date(query.since).toISOString(), until: new Date(query.until).toISOString() },
+      query: { level: query.level, type: query.type, path: query.path, limit: query.limit },
+      retentionDays: store.retentionDays,
+      privacy: PRIVACY,
+      notRecorded: NOT_RECORDED,
+      truncated,
+      summary: summarizeEntries(matching),
+      entries: matching.slice(0, query.limit),
+    };
+    if (cache.size >= 100) cache.clear();
+    cache.set(key, { at, body });
+    return json(body);
+  };
+}
+
+const notFound = () => new Response('Not found', { status: 404 });
+
+// Server wiring: HBL_SERVER_LOG_DIR (default .hbl-private/server-logs),
+// HBL_SERVER_LOG_RETENTION_DAYS (default 14) and HBL_SERVER_LOGS=off to disable.
+// A bad configuration disables logging rather than stopping the game server.
+export function createServerLogs(env = process.env, options = {}) {
+  const buildId = String(env.HBL_BUILD_ID || 'unknown').slice(0, 80);
+  const startedAt = new Date((options.now || Date.now)()).toISOString();
+  const disabled = {
+    enabled: false,
+    instrument: handler => handler,
+    captureConsole: () => () => {},
+    started: () => false,
+    handle: notFound,
+  };
+  if (OFF.test(env.HBL_SERVER_LOGS || '')) return disabled;
+  let store;
+  try {
+    store = createServerLogStore({
+      dir: env.HBL_SERVER_LOG_DIR || DEFAULT_LOG_DIR,
+      retentionDays: env.HBL_SERVER_LOG_RETENTION_DAYS,
+      now: options.now,
+    });
+  } catch (error) {
+    console.error(`[server-logs] disabled: ${error.message}`);
+    return disabled;
+  }
+  const recorder = createServerLogRecorder(store, { appRoot: options.appRoot });
+  return {
+    enabled: true,
+    store,
+    instrument: handler => instrumentFetch(handler, recorder),
+    captureConsole: (target = console) => captureConsole(recorder, target),
+    started: () => recorder.lifecycle('server started', { build: buildId }),
+    handle: createServerLogsHandler({ store, buildId, startedAt, now: options.now }),
+  };
+}
diff --git a/ops/server-logs/capture.js b/ops/server-logs/capture.js
new file mode 100644
index 0000000..d571a9c
--- /dev/null
+++ b/ops/server-logs/capture.js
@@ -0,0 +1,136 @@
+import { normalizePath, redactText } from './redact.js';
+
+export const SLOW_REQUEST_MS = 1500;
+const HEALTH_PATHS = new Set(['/api/health', '/api/ready', '/api/demo/ready']);
+const LOGS_PATH = '/api/server-logs';
+const METHODS = new Set(['GET', 'HEAD', 'POST', 'PUT', 'PATCH', 'DELETE', 'OPTIONS']);
+const STACK_FRAMES = 6;
+
+export function classifyRequest(request, pathname) {
+  if ((request.headers.get('upgrade') || '').toLowerCase() === 'websocket') return 'websocket';
+  if (pathname.startsWith('/api/')) return 'api';
+  const destination = request.headers.get('sec-fetch-dest');
+  if (destination === 'document') return 'page';
+  if (!destination && (request.headers.get('accept') || '').includes('text/html')) return 'page';
+  return 'asset';
+}
+
+// Keep what explains player experience (pages, API calls, failures, slow responses)
+// and skip high-volume noise: successful static assets, health probes and this endpoint.
+export function shouldRecordRequest({ kind, path, status, ms }, slowMs = SLOW_REQUEST_MS) {
+  if (path === LOGS_PATH) return status >= 500;
+  if (HEALTH_PATHS.has(path)) return status >= 400;
+  if (status >= 400 || ms >= slowMs) return true;
+  return kind !== 'asset';
+}
+
+const methodOf = request => METHODS.has(request?.method) ? request.method : 'OTHER';
+const errorName = error => {
+  const name = typeof error?.name === 'string' ? error.name.replace(/[^\w.$-]/g, '').slice(0, 60) : '';
+  return name || 'Error';
+};
+function errorMessage(error) {
+  if (error instanceof Error) return error.message;
+  if (typeof error === 'string') return error;
+  try { return JSON.stringify(error) ?? String(error); } catch { return String(error); }
+}
+function stackFrames(error, appRoot) {
+  if (typeof error?.stack !== 'string') return [];
+  const root = appRoot.endsWith('/') ? appRoot : appRoot + '/';
+  return error.stack.split('\n').map(line => line.trim()).filter(line => line.startsWith('at ')).slice(0, STACK_FRAMES)
+    .map(line => redactText(line.split(root).join('').replace(/file:\/\//g, ''), 200));
+}
+function formatArg(value) {
+  if (typeof value === 'string') return value;
+  if (value instanceof Error) return `${errorName(value)}: ${value.message}`;
+  if (value && typeof value === 'object') {
+    if (typeof value.message === 'string') return value.message;
+    try {
+      const text = JSON.stringify(value);
+      if (text && text !== '{}') return text.slice(0, 300);
+    } catch {}
+    return Object.prototype.toString.call(value);
+  }
+  return String(value);
+}
+
+export function createServerLogRecorder(store, options = {}) {
+  const slowMs = options.slowMs ?? SLOW_REQUEST_MS;
+  const appRoot = options.appRoot ?? process.cwd();
+  return {
+    request(request, pathname, status, ms) {
+      const kind = classifyRequest(request, pathname);
+      const path = pathname.length > 1 ? pathname.replace(/\/$/, '') : pathname;
+      if (!shouldRecordRequest({ kind, path, status, ms }, slowMs)) return false;
+      const slow = ms >= slowMs;
+      return store.record({
+        level: status >= 500 ? 'error' : status >= 400 || slow ? 'warn' : 'info',
+        type: 'request', kind, method: methodOf(request), path: normalizePath(pathname), status,
+        ms: Math.round(ms), ...(slow ? { slow: true } : {}),
+      });
+    },
+    exception(error, request, pathname) {
+      return store.record({
+        level: 'error', type: 'exception', method: methodOf(request), path: normalizePath(pathname),
+        name: errorName(error), message: redactText(errorMessage(error)), stack: stackFrames(error, appRoot),
+      });
+    },
+    console(level, args) {
+      const message = redactText(args.map(formatArg).join(' '));
+      if (!message.trim()) return false;
+      return store.record({ level, type: 'console', message });
+    },
+    lifecycle(message, details = {}) {
+      return store.record({ level: 'info', type: 'lifecycle', message: redactText(message, 200), ...details });
+    },
+  };
+}
+
+const safely = action => {
+  try { action(); } catch {}
+};
+
+// Wraps the Bun.serve fetch handler. Responses and thrown errors pass through
+// unchanged; a successful WebSocket upgrade returns no Response and is logged as 101.
+export function instrumentFetch(handler, recorder, clock = () => performance.now()) {
+  return async function fetchWithServerLogs(request, server) {
+    const started = clock();
+    let pathname = '/';
+    try { pathname = new URL(request.url).pathname; } catch {}
+    let response;
+    try {
+      response = await handler.call(this, request, server);
+    } catch (error) {
+      safely(() => recorder.exception(error, request, pathname));
+      safely(() => recorder.request(request, pathname, 500, clock() - started));
+      throw error;
+    }
+    safely(() => recorder.request(request, pathname, response ? response.status : 101, clock() - started));
+    return response;
+  };
+}
+
+// Mirrors console.error and console.warn into the log. Output still prints as before,
+// and a re-entrancy guard keeps a failing write from looping back into the console.
+export function captureConsole(recorder, target = console) {
+  const originals = {};
+  let busy = false;
+  for (const level of ['error', 'warn']) {
+    const original = target[level];
+    if (typeof original !== 'function' || original.serverLogsCapture) continue;
+    originals[level] = original;
+    const capture = (...args) => {
+      const result = original.apply(target, args);
+      if (!busy) {
+        busy = true;
+        try { recorder.console(level, args); } catch {} finally { busy = false; }
+      }
+      return result;
+    };
+    capture.serverLogsCapture = true;
+    target[level] = capture;
+  }
+  return () => {
+    for (const [level, original] of Object.entries(originals)) target[level] = original;
+  };
+}
diff --git a/ops/server-logs/redact.js b/ops/server-logs/redact.js
new file mode 100644
index 0000000..1f57791
--- /dev/null
+++ b/ops/server-logs/redact.js
@@ -0,0 +1,96 @@
+// Everything recorded by the server-logs module is published at /api/server-logs,
+// so redaction runs before anything reaches disk. Callers never pass IPs, query
+// strings, headers, cookies or request bodies; free text is scrubbed of emails,
+// secrets, network addresses, coordinates and identifiers.
+
+export const MAX_MESSAGE = 500;
+
+const URL_WITH_QUERY = /\b(https?:\/\/[^\s?#"'<>]+)[?#][^\s"'<>]*/gi;
+const EMAIL = /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}/g;
+const BEARER = /\bBearer\s+[A-Za-z0-9._~+/=-]+/gi;
+const SECRET_PAIR = /\b(authorization|cookie|token|secret|password|passwd|api[_-]?key|access[_-]?key|session|signature|credential)(s?\s*[:=]\s*)("[^"]*"|'[^']*'|[^\s,;&)}\]]+)/gi;
+const COORDINATE_PAIR = /-?\d{1,3}\.\d{3,}\s*,\s*-?\d{1,3}\.\d{3,}/g;
+const COORDINATE_FIELD = /\b(lat|lng|lon|latitude|longitude)\b(\s*[:=]?\s*)-?\d{1,3}(?:\.\d+)?/gi;
+const UUID = /\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b/gi;
+const IPV4 = /\b(?:\d{1,3}\.){3}\d{1,3}\b/g;
+const IPV6_CANDIDATE = /(?<![\w:.])[0-9A-Fa-f]{0,4}(?::[0-9A-Fa-f]{0,4}){2,7}(?![\w:])/g;
+const HEX_ID = /\b[0-9a-f]{16,}\b/gi;
+const MIXED_TOKEN = /\b(?=[A-Za-z0-9_-]*\d)(?=[A-Za-z0-9_-]*[A-Za-z])[A-Za-z0-9_-]{20,}\b/g;
+const LONG_NUMBER = /\b\d{9,}\b/g;
+const CONTROL = /[\u0000-\u0008\u000b-\u001f\u007f]/g;
+
+// Clock times such as 12:30:45 have colons too; an address needs a hex letter or "::".
+const looksLikeIpv6 = text => (text.match(/:/g) || []).length >= 2 && (text.includes('::') || /[a-f]/i.test(text));
+
+export function redactText(value, max = MAX_MESSAGE) {
+  const text = String(value ?? '')
+    .replace(CONTROL, ' ')
+    .replace(URL_WITH_QUERY, '$1?[redacted]')
+    .replace(EMAIL, '[email]')
+    .replace(BEARER, 'Bearer [redacted]')
+    .replace(SECRET_PAIR, '$1$2[redacted]')
+    .replace(COORDINATE_PAIR, '[coordinates]')
+    .replace(COORDINATE_FIELD, '$1$2[coordinate]')
+    .replace(UUID, '[id]')
+    .replace(IPV4, '[ip]')
+    .replace(IPV6_CANDIDATE, match => looksLikeIpv6(match) ? '[ip]' : match)
+    .replace(HEX_ID, '[id]')
+    .replace(MIXED_TOKEN, '[token]')
+    .replace(LONG_NUMBER, '[number]');
+  return text.length > max ? text.slice(0, max - 1) + '…' : text;
+}
+
+// Routes whose segments after the prefix are record IDs, share codes, room codes or
+// player-chosen text. Every such segment is replaced unless it is a known action word
+// or a static file name.
+const PRIVATE_SEGMENT_PREFIXES = [
+  '/r/', '/world/date/', '/world/house/', '/github/previews/',
+  '/api/reality-shares/', '/api/world-homes/', '/api/world-experiments/', '/api/world-history/',
+  '/api/runs/', '/api/experiments/', '/api/city-experiments/', '/api/world/experiments/',
+  '/api/decision-experiments/', '/api/decision-optimizations/', '/api/act-normal/rooms/',
+];
+const ACTION_WORDS = new Set(['fork', 'restore', 'date-media', 'house-session', 'image', 'cancel', 'pause',
+  'resume', 'status', 'result', 'results', 'events', 'trace', 'vote', 'compare', 'export']);
+const STATIC_FILE = /\.(?:js|mjs|cjs|css|html?|json|map|png|jpe?g|gif|svg|webp|avif|ico|wasm|glb|gltf|bin|ktx2|hdr|mp3|wav|ogg|mp4|webm|txt|csv|geojson|woff2?|ttf|otf|pdf|md)$/i;
+const UUID_EXACT = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_PATH = 200;
+const MAX_SEGMENTS = 16;
+
+function decode(segment) {
+  try { return decodeURIComponent(segment); } catch { return segment; }
+}
+
+function privateSegment(segment) {
+  const text = decode(segment);
+  return ACTION_WORDS.has(text) || (STATIC_FILE.test(text) && !/[@\s]/.test(text)) ? segment : ':id';
+}
+
+function publicSegment(segment) {
+  const text = decode(segment);
+  if (text.length > 64 || /[@\s]/.test(text)) return ':id';
+  if (STATIC_FILE.test(text)) return segment;
+  if (UUID_EXACT.test(text) || /^[0-9a-f]{16,}$/i.test(text) || /^\d{4,}$/.test(text)) return ':id';
+  const digits = /\d/.test(text);
+  if (digits && /[A-Za-z]/.test(text) && text.length >= 16) return ':id';
+  if (digits && /[a-z]/.test(text) && /[A-Z]/.test(text) && text.length >= 8) return ':id';
+  return segment;
+}
+
+// Keep the route shape (useful for finding broken links and failing handlers) while
+// dropping query strings, fragments and anything that identifies a record or player.
+export function normalizePath(input) {
+  let path = String(input ?? '/');
+  const cut = path.search(/[?#]/);
+  if (cut >= 0) path = path.slice(0, cut);
+  if (!path.startsWith('/')) path = '/' + path;
+  const prefix = PRIVATE_SEGMENT_PREFIXES.find(candidate => path.startsWith(candidate));
+  const fixed = prefix ? prefix.split('/').length - 2 : Infinity;
+  const segments = path.split('/').slice(1);
+  const kept = segments.slice(0, MAX_SEGMENTS).map((segment, index) => {
+    if (!segment) return segment;
+    return index >= fixed ? privateSegment(segment) : publicSegment(segment);
+  });
+  if (segments.length > MAX_SEGMENTS) kept.push('…');
+  const normalized = '/' + kept.join('/');
+  return normalized.length > MAX_PATH ? normalized.slice(0, MAX_PATH - 1) + '…' : normalized;
+}
