# Simple wall light switch OBJ - OFF position
# Units are arbitrary; modeled roughly in centimeters.
# Consists of wall plate + toggle switch.
# OFF position: toggle angled downward.

o LightSwitch_Off

# ----------------------------
# Wall plate
# ----------------------------
# Front face z = 0.20, back face z = 0.00
v -3.50 -5.50 0.00
v  3.50 -5.50 0.00
v  3.50  5.50 0.00
v -3.50  5.50 0.00
v -3.50 -5.50 0.20
v  3.50 -5.50 0.20
v  3.50  5.50 0.20
v -3.50  5.50 0.20

g WallPlate
f 1 2 3 4
f 5 8 7 6
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

# ----------------------------
# Toggle base
# ----------------------------
# Small rectangular housing
v -0.90 -1.80 0.20
v  0.90 -1.80 0.20
v  0.90  1.80 0.20
v -0.90  1.80 0.20
v -0.90 -1.80 0.70
v  0.90 -1.80 0.70
v  0.90  1.80 0.70
v -0.90  1.80 0.70

g ToggleBase
f 9 10 11 12
f 13 16 15 14
f 9 13 14 10
f 10 14 15 11
f 11 15 16 12
f 12 16 13 9

# ----------------------------
# Toggle lever
# Slightly angled downward
# ----------------------------
# upper (pivot) end near base
v -0.45 -0.15 0.70
v  0.45 -0.15 0.70
v  0.45  0.55 0.70
v -0.45  0.55 0.70

# lower end, shifted toward -Y and +Z
v -0.38 -1.15 1.95
v  0.38 -1.15 1.95
v  0.38 -0.55 1.95
v -0.38 -0.55 1.95

g ToggleLever
f 17 18 19 20
f 21 24 23 22
f 17 21 22 18
f 18 22 23 19
f 19 23 24 20
f 20 24 21 17

# ----------------------------
# Screw heads
# Simple shallow octagonal caps
# Top screw center: (0, 4, 0.22)
# Bottom screw center: (0, -4, 0.22)
# ----------------------------

# top screw front ring
v  0.28  4.00 0.28
v  0.20  4.20 0.28
v  0.00  4.28 0.28
v -0.20  4.20 0.28
v -0.28  4.00 0.28
v -0.20  3.80 0.28
v  0.00  3.72 0.28
v  0.20  3.80 0.28
v  0.00  4.00 0.32

g TopScrew
f 25 26 33
f 26 27 33
f 27 28 33
f 28 29 33
f 29 30 33
f 30 31 33
f 31 32 33
f 32 25 33

# bottom screw front ring
v  0.28 -4.00 0.28
v  0.20 -3.80 0.28
v  0.00 -3.72 0.28
v -0.20 -3.80 0.28
v -0.28 -4.00 0.28
v -0.20 -4.20 0.28
v  0.00 -4.28 0.28
v  0.20 -4.20 0.28
v  0.00 -4.00 0.32

g BottomScrew
f 34 35 42
f 35 36 42
f 36 37 42
f 37 38 42
f 38 39 42
f 39 40 42
f 40 41 42
f 41 34 42
