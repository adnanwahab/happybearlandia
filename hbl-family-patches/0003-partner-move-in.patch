+import {describe,expect,test} from 'bun:test';
+import {applyHouseCommitmentCommand} from './commitment-system.js';
+
+function minimal(status='dating'){
+ const people={age:new Uint8Array([1,1]),ageYears:new Uint8Array([30,30]),household:new Uint16Array([0,1]),employed:new Uint8Array(2),work:new Uint16Array(2),x:new Float32Array(2),z:new Float32Array(2),remaining:new Float32Array(2)};
+ const tie={a:'test-p0',b:'test-p1',kind:'Acquaintances',friendship:80,romance:70,tension:5,familiarity:80,dating:status!=='dating'?true:true,commitment:{status,datingSinceMinute:1,engagedSinceMinute:status==='engaged'||status==='married'?2:null,marriedSinceMinute:status==='married'?3:null,endedMinute:null},directed:{'test-p0':{trust:80,attraction:70,resentment:0},'test-p1':{trust:80,attraction:70,resentment:0}},memories:[]};
+ return{prefix:'test',minute:10,tick:1,config:{seed:1},people,social:{ties:{'["test-p0","test-p1"]':tie}},households:{size:new Uint8Array([1,1]),start:new Uint32Array([0,1]),savings:new Float64Array([1000,1000])},houses:{homes:{}},visits:{active:{},completed:[]},locations:[],districts:[]};
+}
+describe('partner move-in admission',()=>{
+ test('requires engagement or marriage before roommate authority is consulted',()=>{const m=minimal('dating');expect(()=>applyHouseCommitmentCommand(m,{householdId:'test-h0'},{type:'moveInPartner',hostPersonId:'test-p0',partnerId:'test-p1',consentingPersonIds:['test-p0','test-p1']})).toThrow('engaged or married');});
+ test('requires explicit agreement from both partners',()=>{const m=minimal('engaged');expect(()=>applyHouseCommitmentCommand(m,{householdId:'test-h0'},{type:'moveInPartner',hostPersonId:'test-p0',partnerId:'test-p1',consentingPersonIds:['test-p0']})).toThrow('explicitly agree');});
+});
