+const unavailable=reason=>({available:false,reason});
+
+export const COMMITMENT_ACTIONS=Object.freeze({
+ propose:{label:'Propose',durationMinutes:30,minAge:18,minParticipants:2,maxParticipants:2,roomId:'living',requiresPartner:true,requiresConsent:true,needRates:{social:.08,fun:.03},requires:['two eligible adult partners','explicit agreement from both Sims'],mechanism:'Both partners spend actual time together. Completion records an engagement on their canonical social tie.'},
+ wedding:{label:'Get married',durationMinutes:60,minAge:18,minParticipants:2,maxParticipants:2,roomId:'living',requiresPartner:true,requiresConsent:true,needRates:{social:.10,fun:.05},requires:['an engaged couple','explicit agreement from both Sims'],mechanism:'Both engaged partners attend the complete ceremony interval. Completion records marriage and a shared milestone memory.'}
+});
+
+function relationshipTie(model,ids){return model.social?.ties?.[pairKey(ids[0],ids[1])]??null;}
+export function commitmentActionAvailability(model,type,ids,consentingPersonIds){
+ if(!COMMITMENT_ACTIONS[type]||!Array.isArray(ids)||ids.length!==2||new Set(ids).size!==2)return unavailable('Choose two distinct adult Sims');
+ if(!consented(ids,consentingPersonIds))return unavailable('Both Sims must explicitly agree');
+ const state=relationshipCommitment(model,ids[0],ids[1]),tie=relationshipTie(model,ids);
+ if(!tie)return unavailable('These Sims need an existing relationship first');
+ const trust=ids.map(id=>tie.directed?.[id]?.trust??50),friendship=tie.friendship??0,romance=tie.romance??0,tension=tie.tension??0;
+ if(type==='propose'){
+  if(state.status!=='dating')return unavailable('Proposal requires an existing dating relationship');
+  if(friendship<55||romance<35||tension>=45||Math.min(...trust)<55)return unavailable('Build friendship, romance and mutual trust, and resolve high tension before proposing');
+ }
+ if(type==='wedding'){
+  if(state.status!=='engaged')return unavailable('Marriage requires an engaged relationship');
+  if(friendship<50||tension>=60||Math.min(...trust)<50)return unavailable('The engaged couple needs enough friendship and trust, with lower tension, before marrying');
+ }
+ return{available:true,relationshipIds:[...ids],commitment:state};
+}
+
+export function planCommitmentAction(model,home,request,participants){
+ if(!Object.hasOwn(COMMITMENT_ACTIONS,request.type))return null;
+ const ids=participants.map(i=>idOf(model,i)),result=commitmentActionAvailability(model,request.type,ids,request.systemOptions?.consentingPersonIds);
+ return result.available?{available:true,data:{relationshipIds:ids}}:result;
+}
+
+export function completeCommitmentAction(model,home,action,minute){
+ if(!['propose','wedding'].includes(action.type))return null;
+ const ids=action.systemData?.commitment?.relationshipIds??action.participants.map(i=>idOf(model,i));
+ const before=relationshipCommitment(model,ids[0],ids[1]),next=action.type==='propose'?'engaged':'married',event=action.type==='propose'?'proposal':'wedding';
+ const text=action.type==='propose'?nameOf(model,ids[0])+' and '+nameOf(model,ids[1])+' got engaged.':nameOf(model,ids[0])+' and '+nameOf(model,ids[1])+' got married.';
+ const result=setRelationshipCommitment(model,ids[0],ids[1],next,minute,{event,text,actionId:action.id,durationMinutes:action.durationMinutes});
+ recordEvent(model,action.type==='propose'?'HOUSE_RELATIONSHIP_ENGAGED':'HOUSE_RELATIONSHIP_MARRIED',{householdId:home.householdId,personIds:ids,actionId:action.id,fromStatus:before.status,toStatus:next,text});
