diff --git a/world/parameter-paired.js b/world/parameter-paired.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-paired.js
@@ -0,0 +1,125 @@
+import { summarizeOutcomes } from "./outcome-analysis.js";
+import { simulateExperiment } from "./simulation-adapter.js";
+
+function clone(value) {
+  return value == null ? value : (typeof structuredClone === "function" ? structuredClone(value) : JSON.parse(JSON.stringify(value)));
+}
+
+function finite(value, fallback = 0) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : fallback;
+}
+
+function variableMap(experiment) {
+  return new Map((experiment?.worldModel?.variables || []).map((variable) => [variable.id, variable]));
+}
+
+function recalc(world, variable, parameterId, baseline) {
+  const min = finite(variable?.range?.min, 0);
+  const max = finite(variable?.range?.max, 1);
+  const span = max - min;
+  const value = finite(world.conditions?.[parameterId], baseline);
+  world.normalized ||= {};
+  world.deviations ||= {};
+  world.normalized[parameterId] = span > 0 ? (value - min) / span : 0.5;
+  world.deviations[parameterId] = span > 0 ? (value - baseline) / span : 0;
+}
+
+export function rebaseWorldForParameterPatch(world, experiment, patch, direction = "baseline") {
+  const next = clone(world);
+  next.conditions ||= {};
+  next.normalized ||= {};
+  next.deviations ||= {};
+  const definitions = variableMap(experiment);
+  const toBaseline = direction === "baseline";
+
+  for (const edit of patch?.edits || []) {
+    const variable = definitions.get(edit.parameterId);
+    if (!variable || !Number.isFinite(Number(next.conditions[edit.parameterId]))) continue;
+    const from = finite(edit.from, finite(variable.baseline));
+    const to = finite(edit.to, from);
+    const delta = to - from;
+    next.conditions[edit.parameterId] = finite(next.conditions[edit.parameterId]) + (toBaseline ? -delta : delta);
+    const min = finite(variable.range?.min, 0);
+    const max = finite(variable.range?.max, 1);
+    next.conditions[edit.parameterId] = Math.max(Math.min(min, max), Math.min(Math.max(min, max), next.conditions[edit.parameterId]));
+    recalc(next, variable, edit.parameterId, toBaseline ? from : to);
+  }
+
+  for (const addition of patch?.additions || []) {
+    const id = addition?.parameterId;
+    if (!id) continue;
+    const variable = definitions.get(id) || addition.variable;
+    if (toBaseline) {
+      delete next.conditions[id];
+      delete next.normalized[id];
+      delete next.deviations[id];
+    } else if (!Number.isFinite(Number(next.conditions[id]))) {
+      next.conditions[id] = finite(addition.proposedValue, finite(variable?.baseline, 0.5));
+      recalc(next, variable, id, finite(addition.proposedValue, 0.5));
+    }
+  }
+
+  next.parameterBranch = toBaseline ? "baseline" : "plan";
+  next.parameterPatchId = patch?.id || null;
+  return next;
+}
+
+export function createBaselineWorldBatch(experiment, worldBatch, patch) {
+  const worlds = (worldBatch?.worlds || []).map((world) => rebaseWorldForParameterPatch(world, experiment, patch, "baseline"));
+  return {
+    ...clone(worldBatch),
+    schemaVersion: "world-batch.v2",
+    branch: "baseline-parameters",
+    parameterPatchId: patch?.id || null,
+    worlds,
+  };
+}
+
+export function summarizePairedParameterRuns(baselineBatch, planBatch) {
+  const baselineByWorld = new Map((baselineBatch?.simulations || []).map((row) => [row.worldId, row]));
+  const pairedWorlds = (planBatch?.simulations || []).map((plan) => {
+    const baseline = baselineByWorld.get(plan.worldId);
+    return {
+      worldId: plan.worldId,
+      baselineScore: baseline?.score ?? null,
+      planScore: plan?.score ?? null,
+      scoreDelta: Number.isFinite(Number(baseline?.score)) && Number.isFinite(Number(plan?.score))
+        ? Number(plan.score) - Number(baseline.score)
+        : null,
+      baselineStatus: baseline?.status || null,
+      planStatus: plan?.status || null,
+    };
+  });
+  const deltas = pairedWorlds.map((row) => row.scoreDelta).filter(Number.isFinite);
+  const meanDelta = deltas.length ? deltas.reduce((sum, value) => sum + value, 0) / deltas.length : null;
+  return {
+    schemaVersion: "paired-parameter-summary.v1",
+    worldCount: pairedWorlds.length,
+    meanScoreDelta: meanDelta,
+    improvedWorlds: pairedWorlds.filter((row) => Number(row.scoreDelta) > 0).length,
+    unchangedWorlds: pairedWorlds.filter((row) => Number(row.scoreDelta) === 0).length,
+    worsenedWorlds: pairedWorlds.filter((row) => Number(row.scoreDelta) < 0).length,
+    pairedWorlds,
+  };
+}
+
+export async function runPairedParameterExperiment({ experiment, worldBatch, adapter, patch, options = {} }) {
+  if (!experiment || !worldBatch || !adapter || !patch) throw new Error("runPairedParameterExperiment requires experiment, worldBatch, adapter, and patch");
+  const baselineWorldBatch = createBaselineWorldBatch(experiment, worldBatch, patch);
+  const baselineBatch = await simulateExperiment(experiment, baselineWorldBatch, adapter, { ...options, parameterPatch: null });
+  const planBatch = await simulateExperiment(experiment, worldBatch, adapter, { ...options, parameterPatch: patch });
+  const paired = summarizePairedParameterRuns(baselineBatch, planBatch);
+
+  return {
+    schemaVersion: "paired-parameter-experiment.v1",
+    experimentId: experiment.id || null,
+    parameterPatchId: patch.id || null,
+    worldBatchSeed: worldBatch.seed ?? null,
+    baseline: { simulationBatch: baselineBatch, summary: summarizeOutcomes(baselineBatch) },
+    plan: { simulationBatch: planBatch, summary: summarizeOutcomes(planBatch) },
+    paired,
+  };
+}
+
+export const __test = { variableMap, recalc };
diff --git a/world/parameter-paired.test.js b/world/parameter-paired.test.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-paired.test.js
@@ -0,0 +1,40 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createSimulationAdapter } from "./simulation-adapter.js";
+import { createBaselineWorldBatch, runPairedParameterExperiment } from "./parameter-paired.js";
+
+const experiment = {
+  id: "exp_pair",
+  plan: { id: "plan_pair", actions: [] },
+  worldModel: { variables: [{ id: "x", baseline: 0.8, range: { min: 0, max: 1 } }] },
+  outcomes: { metricRegistry: [] },
+};
+
+const worldBatch = {
+  seed: 7,
+  worlds: [{ id: "world_1", seed: 11, scenarioFamily: { id: "baseline" }, factors: { economy: 0.2 }, conditions: { x: 0.8 }, normalized: { x: 0.8 }, deviations: { x: 0 } }],
+};
+
+const patch = { id: "ppatch_x", edits: [{ parameterId: "x", from: 0.5, to: 0.8 }], additions: [] };
+
+test("baseline branch preserves random world identity while reversing only the parameter shift", () => {
+  const baseline = createBaselineWorldBatch(experiment, worldBatch, patch);
+  assert.equal(baseline.worlds[0].seed, 11);
+  assert.deepEqual(baseline.worlds[0].factors, { economy: 0.2 });
+  assert.equal(baseline.worlds[0].conditions.x, 0.5);
+  assert.equal(worldBatch.worlds[0].conditions.x, 0.8);
+});
+
+test("paired parameter experiment reports within-world score deltas", async () => {
+  const adapter = createSimulationAdapter({
+    id: "test",
+    simulateWorld({ world }) {
+      return { score: world.conditions.x * 100, metrics: { x: world.conditions.x }, status: "mixed" };
+    },
+  });
+  const result = await runPairedParameterExperiment({ experiment, worldBatch, adapter, patch });
+  assert.equal(result.paired.worldCount, 1);
+  assert.equal(result.paired.pairedWorlds[0].baselineScore, 50);
+  assert.equal(result.paired.pairedWorlds[0].planScore, 80);
+  assert.equal(result.paired.pairedWorlds[0].scoreDelta, 30);
+});
diff --git a/world/parameter-attribution.js b/world/parameter-attribution.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-attribution.js
@@ -0,0 +1,130 @@
+import { simulateExperiment } from "./simulation-adapter.js";
+import { rebaseWorldForParameterPatch } from "./parameter-paired.js";
+
+function clone(value) {
+  return value == null ? value : (typeof structuredClone === "function" ? structuredClone(value) : JSON.parse(JSON.stringify(value)));
+}
+
+function finite(value) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : null;
+}
+
+function mean(values) {
+  const rows = values.map(finite).filter((value) => value !== null);
+  return rows.length ? rows.reduce((sum, value) => sum + value, 0) / rows.length : null;
+}
+
+function quantile(values, q) {
+  const rows = values.map(finite).filter((value) => value !== null).sort((a, b) => a - b);
+  if (!rows.length) return null;
+  const position = Math.max(0, Math.min(1, q)) * (rows.length - 1);
+  const lo = Math.floor(position), hi = Math.ceil(position), w = position - lo;
+  return rows[lo] * (1 - w) + rows[hi] * w;
+}
+
+function round(value, digits = 4) {
+  const number = finite(value);
+  if (number === null) return null;
+  const factor = 10 ** digits;
+  return Math.round(number * factor) / factor;
+}
+
+function parameterRows(patch) {
+  return [
+    ...(patch?.edits || []).map((row) => ({ kind: "edit", parameterId: row.parameterId, label: row.label || row.parameterId, row })),
+    ...(patch?.additions || []).map((row) => ({ kind: "addition", parameterId: row.parameterId, label: row.variable?.label || row.parameterId, row })),
+  ];
+}
+
+function singleParameterPatch(patch, parameter) {
+  return {
+    id: `${patch?.id || "patch"}__${parameter.parameterId}`,
+    edits: parameter.kind === "edit" ? [parameter.row] : [],
+    additions: parameter.kind === "addition" ? [parameter.row] : [],
+  };
+}
+
+function revertedWorldBatch(experiment, worldBatch, patch, parameter) {
+  const single = singleParameterPatch(patch, parameter);
+  return {
+    ...clone(worldBatch),
+    branch: `revert-${parameter.parameterId}`,
+    worlds: (worldBatch?.worlds || []).map((world) => rebaseWorldForParameterPatch(world, experiment, single, "baseline")),
+  };
+}
+
+export async function attributeParameterEffects({
+  experiment,
+  worldBatch,
+  adapter,
+  patch,
+  planBatch = null,
+  options = {},
+} = {}) {
+  if (!experiment || !worldBatch || !adapter || !patch) throw new Error("attributeParameterEffects requires experiment, worldBatch, adapter, and patch");
+  const basePlanBatch = planBatch || await simulateExperiment(experiment, worldBatch, adapter, { ...options, parameterPatch: patch });
+  const planByWorld = new Map((basePlanBatch.simulations || []).map((row) => [row.worldId, row]));
+  const attribution = [];
+  const perWorld = new Map((basePlanBatch.simulations || []).map((row) => [row.worldId, []]));
+
+  for (const parameter of parameterRows(patch)) {
+    const counterfactualWorldBatch = revertedWorldBatch(experiment, worldBatch, patch, parameter);
+    const counterfactualBatch = await simulateExperiment(experiment, counterfactualWorldBatch, adapter, { ...options, parameterPatch: patch });
+    const counterByWorld = new Map((counterfactualBatch.simulations || []).map((row) => [row.worldId, row]));
+    const contributions = [];
+
+    for (const [worldId, plan] of planByWorld) {
+      const counter = counterByWorld.get(worldId);
+      const planScore = finite(plan?.score);
+      const counterScore = finite(counter?.score);
+      const scoreContribution = planScore !== null && counterScore !== null ? planScore - counterScore : null;
+      contributions.push({ worldId, planScore, counterfactualScore: counterScore, scoreContribution: round(scoreContribution) });
+      if (perWorld.has(worldId)) perWorld.get(worldId).push({
+        parameterId: parameter.parameterId,
+        label: parameter.label,
+        scoreContribution: round(scoreContribution),
+      });
+    }
+
+    const values = contributions.map((row) => row.scoreContribution);
+    const meanContribution = mean(values);
+    attribution.push({
+      parameterId: parameter.parameterId,
+      label: parameter.label,
+      kind: parameter.kind,
+      connection: basePlanBatch?.simulationConfig?.parameters?.[parameter.parameterId]?.connection || null,
+      meanScoreContribution: round(meanContribution),
+      p10ScoreContribution: round(quantile(values, 0.1)),
+      p90ScoreContribution: round(quantile(values, 0.9)),
+      absoluteMeanContribution: round(Math.abs(meanContribution ?? 0)),
+      affectedWorlds: values.filter((value) => finite(value) !== null && Math.abs(Number(value)) > 1e-9).length,
+      worldCount: contributions.length,
+      contributions,
+      method: "leave-one-parameter-out-replay",
+      warning: "Modeled contribution from a controlled replay, not real-world causal evidence.",
+    });
+  }
+
+  attribution.sort((a, b) => b.absoluteMeanContribution - a.absoluteMeanContribution || a.parameterId.localeCompare(b.parameterId));
+  const annotatedPlanBatch = {
+    ...clone(basePlanBatch),
+    simulations: (basePlanBatch.simulations || []).map((simulation) => ({
+      ...simulation,
+      parameterContributions: (perWorld.get(simulation.worldId) || []).sort((a, b) => Math.abs(b.scoreContribution || 0) - Math.abs(a.scoreContribution || 0)),
+    })),
+  };
+
+  return {
+    schemaVersion: "parameter-attribution.v1",
+    experimentId: experiment.id || null,
+    parameterPatchId: patch.id || null,
+    metric: "score",
+    method: "leave-one-parameter-out-replay",
+    parameters: attribution,
+    annotatedPlanBatch,
+    warning: "Attribution describes this HBL model under these sampled worlds; it is not proof of real-world causation.",
+  };
+}
+
+export const __test = { mean, quantile, parameterRows, singleParameterPatch };
diff --git a/world/parameter-attribution.test.js b/world/parameter-attribution.test.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-attribution.test.js
@@ -0,0 +1,39 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createSimulationAdapter, simulateExperiment } from "./simulation-adapter.js";
+import { attributeParameterEffects } from "./parameter-attribution.js";
+
+const experiment = {
+  id: "exp_attr",
+  plan: { id: "plan_attr", actions: [] },
+  worldModel: { variables: [
+    { id: "x", baseline: 0.8, range: { min: 0, max: 1 } },
+    { id: "unused", baseline: 0.7, range: { min: 0, max: 1 } },
+  ] },
+  outcomes: { metricRegistry: [] },
+};
+const worldBatch = {
+  seed: 9,
+  worlds: [
+    { id: "w1", conditions: { x: 0.8, unused: 0.7 }, normalized: { x: 0.8, unused: 0.7 }, deviations: { x: 0, unused: 0 } },
+    { id: "w2", conditions: { x: 0.9, unused: 0.8 }, normalized: { x: 0.9, unused: 0.8 }, deviations: { x: 0.1, unused: 0.1 } },
+  ],
+};
+const patch = { id: "p1", edits: [
+  { parameterId: "x", label: "X", from: 0.5, to: 0.8 },
+  { parameterId: "unused", label: "Unused", from: 0.4, to: 0.7 },
+], additions: [] };
+
+test("leave-one-out attribution finds modeled contribution and zero for unused variables", async () => {
+  const adapter = createSimulationAdapter({
+    id: "attr-test",
+    simulateWorld({ world }) { return { score: world.conditions.x * 100, metrics: {}, status: "mixed" }; },
+  });
+  const planBatch = await simulateExperiment(experiment, worldBatch, adapter);
+  const result = await attributeParameterEffects({ experiment, worldBatch, adapter, patch, planBatch });
+  const x = result.parameters.find((row) => row.parameterId === "x");
+  const unused = result.parameters.find((row) => row.parameterId === "unused");
+  assert.equal(x.meanScoreContribution, 30);
+  assert.equal(unused.meanScoreContribution, 0);
+  assert.equal(result.annotatedPlanBatch.simulations[0].parameterContributions[0].parameterId, "x");
+});
diff --git a/world/parameter-explanation.js b/world/parameter-explanation.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-explanation.js
@@ -0,0 +1,69 @@
+function finite(value, fallback = null) {
+  const number = Number(value);
+  return Number.isFinite(number) ? number : fallback;
+}
+
+function variableMap(experiment) {
+  return new Map((experiment?.worldModel?.variables || []).map((variable) => [variable.id, variable]));
+}
+
+function patchMap(patch) {
+  const rows = new Map();
+  for (const edit of patch?.edits || []) rows.set(edit.parameterId, { kind: "edit", ...edit });
+  for (const addition of patch?.additions || []) rows.set(addition.parameterId, {
+    kind: "addition",
+    parameterId: addition.parameterId,
+    label: addition.variable?.label || addition.parameterId,
+    from: null,
+    to: addition.proposedValue,
+    reason: addition.reason,
+  });
+  return rows;
+}
+
+export function explainParameterReality(simulation, experiment, patch = null) {
+  const activePatch = patch || experiment?.lineage?.appliedParameterPatch || null;
+  const variables = variableMap(experiment);
+  const changes = patchMap(activePatch);
+  const contributions = Array.isArray(simulation?.parameterContributions) ? simulation.parameterContributions : [];
+
+  const rows = contributions.map((contribution) => {
+    const change = changes.get(contribution.parameterId) || {};
+    const variable = variables.get(contribution.parameterId) || {};
+    const scoreContribution = finite(contribution.scoreContribution, 0);
+    return {
+      parameterId: contribution.parameterId,
+      label: contribution.label || change.label || variable.label || contribution.parameterId,
+      from: finite(change.from),
+      to: finite(change.to ?? change.proposedValue ?? variable.baseline),
+      unit: change.unit || variable.unit || "index",
+      reason: change.reason || variable.reason || null,
+      connection: simulation?.simulationConfig?.parameters?.[contribution.parameterId]?.connection || null,
+      scoreContribution,
+      direction: scoreContribution > 1e-9 ? "helped" : scoreContribution < -1e-9 ? "hurt" : "no-modeled-effect",
+    };
+  }).sort((a, b) => Math.abs(b.scoreContribution) - Math.abs(a.scoreContribution));
+
+  const strongest = rows[0] || null;
+  const eventRows = (simulation?.events || []).slice(0, 8).map((event) => ({
+    year: event.year ?? null,
+    type: event.type || "event",
+    severity: finite(event.severity, 0),
+    description: event.description || null,
+  }));
+
+  return {
+    schemaVersion: "parameter-reality-explanation.v1",
+    worldId: simulation?.worldId || simulation?.world?.id || null,
+    parameterPatchId: activePatch?.id || simulation?.simulationConfig?.parameterPatchId || null,
+    score: finite(simulation?.score),
+    changes: rows,
+    strongest,
+    events: eventRows,
+    causalPathways: Array.isArray(simulation?.explanation?.causalPathways) ? simulation.explanation.causalPathways : [],
+    summary: strongest
+      ? `${strongest.label} ${strongest.direction === "helped" ? "helped" : strongest.direction === "hurt" ? "hurt" : "had no modeled score effect in"} this reality by ${Math.abs(strongest.scoreContribution).toFixed(2)} score points.`
+      : "No parameter replay attribution is attached to this reality yet.",
+    warning: "This explanation traces HBL model behavior, not real-world causal proof.",
+  };
+}
diff --git a/world/parameter-explanation.test.js b/world/parameter-explanation.test.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-explanation.test.js
@@ -0,0 +1,23 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { explainParameterReality } from "./parameter-explanation.js";
+
+test("parameter reality explanation uses recorded per-world replay contributions", () => {
+  const experiment = {
+    worldModel: { variables: [{ id: "permit", label: "Permit delay", unit: "months", baseline: 3 }] },
+    lineage: { appliedParameterPatch: { id: "p1", edits: [{ parameterId: "permit", label: "Permit delay", from: 8, to: 3, reason: "Faster approval" }], additions: [] } },
+  };
+  const simulation = {
+    worldId: "w1",
+    score: 72,
+    simulationConfig: { parameters: { permit: { connection: "model-variable" } } },
+    parameterContributions: [{ parameterId: "permit", label: "Permit delay", scoreContribution: 6.25 }],
+    events: [{ year: 1, type: "rollout-start", severity: 0.4 }],
+  };
+  const explanation = explainParameterReality(simulation, experiment);
+  assert.equal(explanation.parameterPatchId, "p1");
+  assert.equal(explanation.changes[0].from, 8);
+  assert.equal(explanation.changes[0].to, 3);
+  assert.equal(explanation.changes[0].scoreContribution, 6.25);
+  assert.match(explanation.summary, /helped/);
+});
