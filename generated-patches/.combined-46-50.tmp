diff --git a/world/parameter-workspace.js b/world/parameter-workspace.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-workspace.js
@@ -0,0 +1,121 @@
+import { summarizeOutcomes } from "./outcome-analysis.js";
+import { attributeParameterEffects } from "./parameter-attribution.js";
+import { createBaselineWorldBatch, rebaseWorldForParameterPatch, runPairedParameterExperiment } from "./parameter-paired.js";
+import { applyPlanParameterPatch } from "./plan-parameter-patch.js";
+import { applyParameterRevision } from "./parameter-revision.js";
+import { buildSimulationConfig } from "./simulation-config.js";
+import { simulateExperiment } from "./simulation-adapter.js";
+import { validateParameterConfiguration } from "./parameter-constraints.js";
+
+function clone(value) {
+  return value == null ? value : (typeof structuredClone === "function" ? structuredClone(value) : JSON.parse(JSON.stringify(value)));
+}
+
+function variableFor(experiment, parameterId) {
+  return (experiment?.worldModel?.variables || []).find((row) => row.id === parameterId) || null;
+}
+
+export function revisionSuggestionPatch(experiment, worldBatch, suggestion) {
+  const edit = suggestion?.parameterEdit;
+  if (!edit?.parameterId || !Number.isFinite(Number(edit.value))) throw new Error("Revision suggestion requires a numeric parameterEdit");
+  const parameterId = edit.parameterId;
+  const variable = variableFor(experiment, parameterId);
+  const from = Number(worldBatch?.simulationConfig?.parameters?.[parameterId]?.baseline ?? variable?.baseline ?? 0);
+  const to = Number(edit.value);
+  return {
+    schemaVersion: "hbl-parameter-patch.v1",
+    id: "revision_patch_" + String(suggestion.id || parameterId),
+    sourceFingerprint: "revision:" + String(suggestion.id || parameterId),
+    planId: experiment?.plan?.id || null,
+    experimentId: experiment?.id || null,
+    edits: [{
+      parameterId,
+      label: variable?.label || parameterId,
+      category: variable?.category || "custom",
+      unit: variable?.unit || "index",
+      from,
+      to,
+      operation: "set",
+      requestedOperation: edit.operation || "set",
+      source: "simulation-revision",
+      reason: edit.reason || suggestion.title || "Simulation-derived parameter revision.",
+      evidence: [],
+      confidence: 1,
+    }],
+    additions: [],
+    warnings: [],
+    summary: { editCount: 1, additionCount: 0, explicitEditCount: 1, heuristicEditCount: 0, unconnectedAdditionCount: 0 },
+  };
+}
+
+export async function runParameterWorkspaceAnalysis({ experiment, worldBatch, simulationBatch, adapter, patch, overrides = {}, options = {} } = {}) {
+  if (!experiment || !worldBatch || !simulationBatch || !adapter || !patch) throw new Error("runParameterWorkspaceAnalysis requires experiment, worldBatch, simulationBatch, adapter, and patch");
+  const paired = await runPairedParameterExperiment({
+    experiment,
+    worldBatch,
+    adapter,
+    patch,
+    options: { ...options, planBatch: simulationBatch },
+  });
+  const attribution = await attributeParameterEffects({
+    experiment,
+    worldBatch,
+    adapter,
+    patch,
+    planBatch: simulationBatch,
+    options,
+  });
+  const parameterConstraints = validateParameterConfiguration(experiment, overrides, { parameterPatch: patch });
+  return {
+    schemaVersion: "parameter-workspace-analysis.v1",
+    paired,
+    attribution,
+    parameterConstraints,
+    simulationBatch: attribution.annotatedPlanBatch,
+  };
+}
+
+export async function rerunParameterRevision({ experiment, worldBatch, simulationBatch, adapter, suggestion, overrides = {}, options = {} } = {}) {
+  if (!experiment || !worldBatch || !simulationBatch || !adapter || !suggestion) throw new Error("rerunParameterRevision requires experiment, worldBatch, simulationBatch, adapter, and suggestion");
+  const before = summarizeOutcomes(simulationBatch);
+  const revisedExperiment = applyParameterRevision(experiment, suggestion);
+  const revisionPatch = revisionSuggestionPatch(revisedExperiment, worldBatch, suggestion);
+  const nextOverrides = clone(overrides || {});
+  const variable = variableFor(revisedExperiment, revisionPatch.edits[0].parameterId);
+  const current = nextOverrides[revisionPatch.edits[0].parameterId] || {};
+  nextOverrides[revisionPatch.edits[0].parameterId] = {
+    ...current,
+    baseline: revisionPatch.edits[0].to,
+    min: current.min ?? variable?.range?.min,
+    max: current.max ?? variable?.range?.max,
+    locked: typeof current.locked === "boolean" ? current.locked : Boolean(variable?.locked),
+    reason: "Applied simulation-derived revision " + suggestion.id,
+  };
+  const applied = applyPlanParameterPatch(revisedExperiment, revisionPatch, nextOverrides);
+  const revisedWorldBatch = {
+    ...clone(worldBatch),
+    branch: "parameter-revision-" + suggestion.id,
+    worlds: (worldBatch.worlds || []).map((world) => rebaseWorldForParameterPatch(world, applied.experiment, revisionPatch, "plan")),
+  };
+  revisedWorldBatch.simulationConfig = buildSimulationConfig(applied.experiment, applied.overrides, { parameterPatch: revisionPatch });
+  const rerun = await simulateExperiment(applied.experiment, revisedWorldBatch, adapter, { ...options, parameterPatch: revisionPatch });
+  const after = summarizeOutcomes(rerun);
+
+  return {
+    schemaVersion: "parameter-revision-rerun.v1",
+    suggestion,
+    revisionPatch,
+    experiment: applied.experiment,
+    overrides: applied.overrides,
+    worldBatch: revisedWorldBatch,
+    simulationBatch: rerun,
+    before,
+    after,
+    scoreDelta: Number(after.expectedScore || 0) - Number(before.expectedScore || 0),
+    robustnessDelta: Number(after.robustness || 0) - Number(before.robustness || 0),
+    sameWorldIds: JSON.stringify((worldBatch.worlds || []).map((row) => row.id)) === JSON.stringify((revisedWorldBatch.worlds || []).map((row) => row.id)),
+    sameWorldSeeds: JSON.stringify((worldBatch.worlds || []).map((row) => row.seed)) === JSON.stringify((revisedWorldBatch.worlds || []).map((row) => row.seed)),
+  };
+}
+
+export { createBaselineWorldBatch };
diff --git a/world/parameter-workspace.test.js b/world/parameter-workspace.test.js
new file mode 100644
--- /dev/null
+++ b/world/parameter-workspace.test.js
@@ -0,0 +1,40 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createSimulationAdapter, simulateExperiment } from "./simulation-adapter.js";
+import { rerunParameterRevision, runParameterWorkspaceAnalysis } from "./parameter-workspace.js";
+
+const experiment = {
+  id: "e",
+  plan: { id: "p", title: "Plan", actions: [], parameterEdits: [] },
+  worldModel: { variables: [{ id: "x", label: "X", baseline: 0.8, range: { min: 0, max: 1 } }] },
+  outcomes: { metricRegistry: [] },
+  lineage: { revision: 1, appliedParameterPatch: { id: "p1", sourceFingerprint: "s1", edits: [{ parameterId: "x", from: 0.5, to: 0.8 }], additions: [] } },
+};
+const patch = experiment.lineage.appliedParameterPatch;
+const worldBatch = {
+  seed: 42,
+  simulationConfig: { parameters: { x: { baseline: 0.8 } } },
+  worlds: [
+    { id: "w1", seed: 1, factors: {}, conditions: { x: 0.8 }, normalized: { x: 0.8 }, deviations: { x: 0 } },
+    { id: "w2", seed: 2, factors: {}, conditions: { x: 0.9 }, normalized: { x: 0.9 }, deviations: { x: 0.1 } },
+  ],
+};
+const adapter = createSimulationAdapter({ id: "workspace", simulateWorld({ world }) { return { score: world.conditions.x * 100, metrics: {}, status: "positive" }; } });
+
+test("workspace analysis pairs baseline and plan and annotates parameter contributions", async () => {
+  const planBatch = await simulateExperiment(experiment, worldBatch, adapter);
+  const result = await runParameterWorkspaceAnalysis({ experiment, worldBatch, simulationBatch: planBatch, adapter, patch });
+  assert.equal(result.paired.paired.worldCount, 2);
+  assert.equal(result.attribution.parameters[0].meanScoreContribution, 30);
+  assert.equal(result.simulationBatch.simulations[0].parameterContributions[0].parameterId, "x");
+});
+
+test("revision rerun preserves world ids and seeds", async () => {
+  const planBatch = await simulateExperiment(experiment, worldBatch, adapter);
+  const suggestion = { id: "r1", title: "Reduce X", parameterEdit: { parameterId: "x", operation: "set", value: 0.6, reason: "test" } };
+  const result = await rerunParameterRevision({ experiment, worldBatch, simulationBatch: planBatch, adapter, suggestion });
+  assert.equal(result.sameWorldIds, true);
+  assert.equal(result.sameWorldSeeds, true);
+  assert.equal(result.worldBatch.worlds[0].conditions.x, 0.6);
+  assert.equal(result.experiment.lineage.revision, 2);
+});
diff --git a/world/simulation-config.js b/world/simulation-config.js
--- a/world/simulation-config.js
+++ b/world/simulation-config.js
@@ -30,7 +30,7 @@ export function classifyParameterConnection(variable) {
   if (variable.modelBinding || variable.connected === true) return "mechanic-connected";
   if (variable.causalBinding || variable.causalNodeId || variable.causal_node_id) return "causal-graph-connected";
   if (variable.source === "plan-parameter-patch" && variable.connected !== true) return "sampled-only";
-  return "model-variable";
+  return "mechanic-connected";
 }
 
 export function buildSimulationConfig(experiment, overrides = {}, options = {}) {
