# Server environment only. Never place keys in HTML, VITE_*, PUBLIC_*, or commits.
# Demo is deterministic local parsing, not AI. No key or vendor request required.
AI_PROVIDER=demo
# A live adapter is configured only when BOTH its key and model are set.
# Choose a model your account supports with the vendor's structured JSON output.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
# Calls have 20s default timeout, 128KiB response bound, 4096 output-token bound,
# two concurrent remote requests, and ten remote requests/minute per client.
# Only numeric scenario inputs, selected project geometry/program/finance,
# model field definitions and the explicit edit prompt are sent, never evidence,
# journals, resident/customer records, source uploads, or repository files.
